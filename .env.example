# Copy to .env and fill in. Used by docker compose and the Vite dev server.

# The AgentOS runtime the control plane talks to.
#   - dev (vite): AGENTOS_URL is the target the dev server proxies /api to
#   - docker: AGENTOS_UPSTREAM is the target seen from inside the container
AGENTOS_URL=http://127.0.0.1:8000
AGENTOS_UPSTREAM=http://host.docker.internal:8000

# Shared bearer token for the AgentOS REST API (security_key auth mode).
# The proxy injects it; it never reaches the browser.
OS_SECURITY_KEY=

# Control-plane login password. When set, the login screen requires it and the
# proxy rejects /api without a matching X-CP-Auth header. Empty = no gate.
CP_AUTH_TOKEN=
